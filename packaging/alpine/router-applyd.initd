#!/sbin/openrc-run
# OpenRC service script for Minimal Router OS router-applyd (privileged helper)

name="router-applyd"
description="Minimal Router OS privileged execution helper"
supervisor="supervise-daemon"
command="/usr/sbin/router-applyd"
pidfile="/run/${RC_SVCNAME}.supervisor.pid"
output_log="/var/log/router-applyd.log"
error_log="/var/log/router-applyd.err"

# Opt in only for the installed appliance. Every initial start and supervised
# respawn reconciles the verified canonical configuration before the privileged
# socket is made available again.
export MINIMALROUTER_APPLYD_STARTUP_RECONCILE=1
# Lab fault-injection hooks: default empty (disabled); the torture lab sets
# /etc/conf.d/router-applyd MINIMALROUTER_FAULT_HOOK_DIR=/run/minimalrouter-fault.
export MINIMALROUTER_FAULT_HOOK_DIR="${MINIMALROUTER_FAULT_HOOK_DIR:-}"

# Restart isolated process crashes, but stop after a bounded crash burst instead
# of repeatedly applying state when a persistent fault is present.
respawn_delay=2
respawn_max=5
respawn_period=60
retry="SIGTERM/10/SIGKILL/5"

depend() {
    before routerd
    need localmount
    # The helper owns every WAN/LAN/tunnel interface. Ordering after the
    # distribution network service prevents ifupdown from re-running against
    # an interface whose address configureRuntimeLAN() has already installed.
    # routerd needs net too, so without this the relative order of `net` and
    # this helper was left undefined by OpenRC.
    after net
    use logger
}

install_web_update_bridge() {
    # Web updates deliberately cross the root boundary only through this
    # installer-managed integration file. A/B activation compares this OpenRC
    # script byte-for-byte with the installed copy, so a release that changes
    # the privilege contract requires the full distribution installer first.
    install -d -m 0755 -o root -g root /usr/libexec/minimalrouter /etc/doas.d

    cat > /usr/libexec/minimalrouter/routerd-update <<'UPDATE_HELPER'
#!/bin/sh
set -eu

INBOX=/var/lib/minimalrouter/update-inbox

case "$(uname -m)" in
    x86_64) BIN_ARCH=amd64 ;;
    aarch64) BIN_ARCH=arm64 ;;
    *) echo "ERROR: unsupported update architecture" >&2; exit 1 ;;
esac

case "${1:-}" in
    stage)
        [ "$#" -eq 1 ] || { echo "ERROR: stage accepts no arguments" >&2; exit 2; }
        exec /usr/sbin/router-update stage \
            --dir "$INBOX/release/minimalrouter-linux-$BIN_ARCH" \
            --manifest "$INBOX/manifest.json"
        ;;
    activate)
        [ "$#" -eq 1 ] || { echo "ERROR: activate accepts no arguments" >&2; exit 2; }
        pending="$(/usr/sbin/router-update status | sed -n 's/.*"pending"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)"
        [ -n "$pending" ] || { echo "ERROR: no verified release is pending activation" >&2; exit 1; }
        exec /usr/sbin/router-update activate --version "$pending" --confirm ACTIVATE-UPDATE
        ;;
    *)
        echo "Usage: routerd-update {stage|activate}" >&2
        exit 2
        ;;
esac
UPDATE_HELPER
    chown root:root /usr/libexec/minimalrouter/routerd-update
    chmod 0755 /usr/libexec/minimalrouter/routerd-update

    cat > /etc/doas.d/51-minimalrouter-update.conf <<'DOAS_UPDATE'
permit nopass routerd as root cmd /usr/libexec/minimalrouter/routerd-update args stage
permit nopass routerd as root cmd /usr/libexec/minimalrouter/routerd-update args activate
DOAS_UPDATE
    chown root:root /etc/doas.d/51-minimalrouter-update.conf
    chmod 0400 /etc/doas.d/51-minimalrouter-update.conf
}

start_pre() {
    checkpath --directory --owner root:routerd --mode 0750 /run/minimalrouter
    checkpath --directory --owner root:root --mode 0700 /var/lib/minimalrouter-applyd
    # A startup verification hint is valid only for this helper start. Remove
    # any stale handoff before the privileged process performs reconciliation.
    rm -f /run/minimalrouter/startup-verified.sha256
    # Updating is optional. A damaged/read-only update integration must never
    # prevent the core router from starting; the dashboard reports the update
    # feature unavailable while routing/recovery continue normally.
    if ! install_web_update_bridge; then
        ewarn "signed web-update privilege bridge is unavailable"
    fi
    rm -f /run/minimalrouter/apply.sock
}

publish_startup_hash() {
    last_good=/var/lib/minimalrouter-applyd/last-good.json
    marker=/run/minimalrouter/startup-verified.sha256
    [ -f "$last_good" ] || return 0

    digest="$(sha256sum "$last_good" 2>/dev/null || true)"
    digest="${digest%% *}"
    case "$digest" in
        ''|*[!0-9a-f]*) return 0 ;;
    esac
    [ "${#digest}" -eq 64 ] || return 0

    if printf '%s\n' "$digest" > "$marker"; then
        chown root:root "$marker" 2>/dev/null || true
        chmod 0600 "$marker" 2>/dev/null || true
    else
        rm -f "$marker"
    fi
}

# routerd must not be released merely because the supervisor was forked. The
# socket appears only after startup reconciliation has completed successfully.
start_post() {
    attempts=0
    while [ "$attempts" -lt 360 ]; do
        if [ -S /run/minimalrouter/apply.sock ]; then
            # saveLastGood serializes config.SystemConfig with json.Marshal.
            # Hashing that exact root-owned file lets routerd prove its SQLite
            # canonical config is byte-for-byte the runtime just verified by
            # this helper, without repeating a second full apply on cold boot.
            publish_startup_hash
            chgrp routerd "$pidfile"
            chmod 0640 "$pidfile"
            return 0
        fi
        attempts=$((attempts + 1))
        sleep 0.25
    done
    eerror "router-applyd did not complete startup reconciliation"
    return 1
}

umask="0077"
rc_ulimit="-c 0 -n 1024"
