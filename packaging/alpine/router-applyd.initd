#!/sbin/openrc-run
# OpenRC service script for Minimal Router OS router-applyd (privileged helper)

name="router-applyd"
description="Minimal Router OS privileged execution helper"
supervisor="supervise-daemon"
command="/usr/sbin/router-applyd"
pidfile="/run/${RC_SVCNAME}.supervisor.pid"
output_log="/var/log/router-applyd.log"
error_log="/var/log/router-applyd.err"

# Opt in only for the installed appliance. Every initial start and supervised
# respawn reconciles the verified canonical configuration before the privileged
# socket is made available again.
export MINIMALROUTER_APPLYD_STARTUP_RECONCILE=1

# Restart isolated process crashes, but stop after a bounded crash burst instead
# of repeatedly applying state when a persistent fault is present.
respawn_delay=2
respawn_max=5
respawn_period=60
retry="SIGTERM/10/SIGKILL/5"

depend() {
    before routerd
    need localmount
    use logger
}

start_pre() {
    checkpath --directory --owner root:routerd --mode 0750 /run/minimalrouter
    checkpath --directory --owner root:root --mode 0700 /var/lib/minimalrouter-applyd
    rm -f /run/minimalrouter/apply.sock
}

# routerd must not be released merely because the supervisor was forked. The
# socket appears only after startup reconciliation has completed successfully.
start_post() {
    attempts=0
    while [ "$attempts" -lt 120 ]; do
        if [ -S /run/minimalrouter/apply.sock ]; then
            chgrp routerd "$pidfile"
            chmod 0640 "$pidfile"
            return 0
        fi
        attempts=$((attempts + 1))
        sleep 0.25
    done
    eerror "router-applyd did not complete startup reconciliation"
    return 1
}

umask="0077"
rc_ulimit="-c 0 -n 1024"
