#!/bin/ash
# Static packaging hook (not generated, not user-driven): pppd recreates
# ppp0 on every reconnect, which wipes the router's tc qdiscs. Ask
# router-applyd to rebuild traffic shaping from its last-good config.
# No argument from the peer file reaches a shell.
set -eu

[ "${1:-}" = "ppp0" ] || exit 0
exec /usr/sbin/router-applyd --reapply-qos