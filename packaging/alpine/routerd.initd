#!/sbin/openrc-run
# OpenRC service script for Minimal Router OS routerd (management plane)

name="routerd"
description="Minimal Router OS unprivileged management service"
supervisor="supervise-daemon"
command="/usr/bin/routerd"
command_user="routerd:routerd"
pidfile="/run/${RC_SVCNAME}.supervisor.pid"
output_log="/var/log/routerd.log"
error_log="/var/log/routerd.err"

# Restart isolated process crashes, but stop after a bounded crash burst instead
# of hiding a persistent fault in an infinite respawn loop.
respawn_delay=2
respawn_max=5
respawn_period=60
retry="SIGTERM/10/SIGKILL/5"

depend() {
    need net
    need router-applyd
    use logger
}

start_pre() {
    checkpath --directory --owner routerd:routerd --mode 0700 /var/lib/minimalrouter
    # DHCP leases live in a dedicated dnsmasq-owned 0750 directory. Give the
    # management daemon only the supplementary group needed to read that live
    # status; canonical config/auth storage stays private to routerd.
    addgroup routerd dnsmasq >/dev/null 2>&1 || true

    # OpenRC must not report the management plane started merely because the
    # supervise-daemon parent exists. Pre-create a zero-length marker that only
    # routerd can fill after canonical reconcile and TLS setup have succeeded.
    checkpath --directory --owner root:routerd --mode 0750 /run/minimalrouter
    checkpath --directory --owner routerd:routerd --mode 0700 /run/minimalrouter/routerd-state
    checkpath --file --owner routerd:routerd --mode 0600 /run/minimalrouter/routerd.ready
    : > /run/minimalrouter/routerd.ready
    chown routerd:routerd /run/minimalrouter/routerd.ready
    chmod 0600 /run/minimalrouter/routerd.ready

    # Consume the root-only helper handoff exactly once per OpenRC start. The
    # destination remains root-owned/read-only; routerd can verify but cannot
    # forge it. The routerd-owned O_EXCL marker enforces one-shot behavior across
    # supervise-daemon respawns that do not re-run this start_pre function.
    rm -f /run/minimalrouter/routerd-startup-verified.sha256
    rm -f /run/minimalrouter/routerd-state/startup-fastpath-consumed
    if [ -f /run/minimalrouter/startup-verified.sha256 ]; then
        if mv /run/minimalrouter/startup-verified.sha256 /run/minimalrouter/routerd-startup-verified.sha256; then
            chown root:routerd /run/minimalrouter/routerd-startup-verified.sha256
            chmod 0640 /run/minimalrouter/routerd-startup-verified.sha256
        fi
    fi
}

start_post() {
    # 1200 x 0.25s = 300s. Must stay above apply.ReconcileBudget (270s) so a
    # slow-but-succeeding canonical reconcile is not reported as a failed start.
    attempts=0
    while [ "$attempts" -lt 1200 ]; do
        if [ -s /run/minimalrouter/routerd.ready ]; then
            chgrp routerd "$pidfile"
            chmod 0640 "$pidfile"
            return 0
        fi
        attempts=$((attempts + 1))
        sleep 0.25
    done
    eerror "routerd did not complete canonical reconciliation and management startup"
    return 1
}

stop_post() {
    : > /run/minimalrouter/routerd.ready 2>/dev/null || true
    rm -f /run/minimalrouter/routerd-startup-verified.sha256
}

umask="0077"
rc_ulimit="-c 0 -n 4096"

export MINIMALROUTER_DATA_DIR="/var/lib/minimalrouter"
export MINIMALROUTER_WEB_DIR="/usr/share/minimalrouter/web"
export MINIMALROUTER_READY_FILE="/run/minimalrouter/routerd.ready"
# Lab fault-injection hooks: default empty (disabled); the torture lab sets
# /etc/conf.d/routerd MINIMALROUTER_FAULT_HOOK_DIR=/run/minimalrouter-fault.
export MINIMALROUTER_FAULT_HOOK_DIR="${MINIMALROUTER_FAULT_HOOK_DIR:-}"
