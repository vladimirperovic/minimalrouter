#!/usr/bin/expect -f

set timeout 900
set iso [lindex $argv 0]
set disk [lindex $argv 1]
set logpath [lindex $argv 2]

if {$iso eq "" || $disk eq "" || $logpath eq ""} {
    puts stderr "usage: iso-full-install.exp <iso> <disk> <log>"
    exit 2
}

set dashboard_password "MinimalRouterCI-2026!"
set recovery_password "MRciRecovery-2026!"

log_user 1
log_file -noappend $logpath
match_max 65536

spawn qemu-system-x86_64 \
    -machine pc,accel=tcg \
    -cpu max \
    -smp 1 \
    -m 1536 \
    -boot once=d \
    -cdrom $iso \
    -drive file=$disk,format=raw,if=virtio \
    -netdev user,id=wan \
    -device virtio-net-pci,netdev=wan \
    -netdev user,id=lan \
    -device virtio-net-pci,netdev=lan \
    -display none \
    -serial stdio \
    -no-shutdown

proc wait_and_send {pattern text} {
    expect {
        -re $pattern { send -- $text }
        timeout {
            puts stderr "timeout waiting for: $pattern"
            exit 20
        }
        eof {
            puts stderr "QEMU exited while waiting for: $pattern"
            exit 21
        }
    }
}

# Match stable semantic fragments rather than every punctuation character. A
# real TTY may inject terminal-control bytes around a prompt even though the
# visible text is unchanged.
wait_and_send {Press Enter to continue} "\r"
wait_and_send {PPPoE username} "\r"
wait_and_send {Use these WAN/LAN roles} "\r"
wait_and_send {administrator password.*12 characters} "$dashboard_password\r"
wait_and_send {Confirm dashboard password} "$dashboard_password\r"
wait_and_send {Install and apply this configuration} "\r"

# BusyBox passwd wording differs slightly between Alpine point releases.
expect {
    -re {New.*password:} { send -- "$recovery_password\r" }
    timeout { puts stderr "timeout waiting for recovery password prompt"; exit 22 }
    eof { puts stderr "QEMU exited before recovery password prompt"; exit 23 }
}
expect {
    -re {Retype.*password:} { send -- "$recovery_password\r" }
    timeout { puts stderr "timeout waiting for recovery password confirmation"; exit 24 }
    eof { puts stderr "QEMU exited before recovery password confirmation"; exit 25 }
}

wait_and_send {Install Minimal Router OS.*to disk.*vda} "\r"
wait_and_send {Type ERASE to continue} "ERASE\r"

# This marker is printed only after setup-disk, target APK installation,
# install-core, SSH/serial target setup and configuration-state copy complete.
expect {
    -re {Minimal Router OS.*installation completed successfully} {}
    -re {ERROR:} {
        puts stderr "installer reported an error"
        exit 30
    }
    timeout { puts stderr "timeout waiting for completed disk installation"; exit 31 }
    eof { puts stderr "QEMU exited before completed disk installation"; exit 32 }
}

# The live system reboots. -boot once=d makes the next boot use the installed
# VirtIO disk even though the ISO is still attached.
expect {
    -re {login:} { send -- "root\r" }
    timeout { puts stderr "timeout waiting for installed-system login"; exit 40 }
    eof { puts stderr "QEMU exited before installed-system login"; exit 41 }
}
expect {
    -re {Password:} { send -- "$recovery_password\r" }
    timeout { puts stderr "timeout waiting for installed-system password"; exit 42 }
}

# Wait for a root shell and validate what matters for a recoverable appliance.
expect {
    -re {# $} {}
    -re {~ #} {}
    timeout { puts stderr "timeout waiting for installed-system root shell"; exit 43 }
}

set checks {
    {test -x /usr/bin/routerd && echo CHECK_ROUTERD_OK}
    {test -x /usr/sbin/router-applyd && echo CHECK_APPLYD_OK}
    {rc-update show default | grep -q '[[:space:]]sshd' && echo CHECK_SSHD_ENABLED}
    {grep -q '^ttyS0::respawn:' /etc/inittab && echo CHECK_SERIAL_GETTY_OK}
    {grep -q 'v3.22/main' /etc/apk/repositories && grep -q 'v3.22/community' /etc/apk/repositories && echo CHECK_APK_REPOS_OK}
    {test -s /var/lib/minimalrouter/minimalrouter.db && echo CHECK_STATE_DB_OK}
    {ip -4 addr | grep -q '192.168.1.1/24' && echo CHECK_LAN_IP_OK}
    {nft list ruleset | grep -q 'tcp dport 22 accept' && echo CHECK_NFT_SSH_OK}
    {ss -lnt | grep -q ':22 ' && echo CHECK_SSH_LISTEN_OK}
}

foreach command $checks {
    send -- "$command\r"
}
send -- "echo FULL_ISO_INSTALL_OK\r"

foreach marker {
    CHECK_ROUTERD_OK
    CHECK_APPLYD_OK
    CHECK_SSHD_ENABLED
    CHECK_SERIAL_GETTY_OK
    CHECK_APK_REPOS_OK
    CHECK_STATE_DB_OK
    CHECK_LAN_IP_OK
    CHECK_NFT_SSH_OK
    CHECK_SSH_LISTEN_OK
    FULL_ISO_INSTALL_OK
} {
    expect {
        -re $marker {}
        timeout { puts stderr "missing installed-system marker: $marker"; exit 50 }
        eof { puts stderr "QEMU exited before marker: $marker"; exit 51 }
    }
}

send -- "poweroff -f\r"
expect {
    eof {}
    timeout {
        # QEMU -no-shutdown can keep the process alive after guest poweroff.
        send -- "\003"
    }
}

exit 0
