{
  "name": "minimal-router-dashboard",
  "version": "0.4.2",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/precompress.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ignore-pattern dist",
    "test": "vitest run && node --test scripts/precompress.test.mjs",
    "test:e2e": "playwright test",
    "dev:demo": "vite --mode demo --port 5251 --strictPort",
    "test:visual": "vite build && playwright test --project=chromium e2e/theme-visual.spec.ts"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "26.6.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "tailwindcss": "4.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  },
  "type": "module"
}
